<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cassius2.App"
             xmlns:local="using:Cassius2"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <SolidColorBrush x:Key="NordAuroraRed">#BF616A</SolidColorBrush>
        <SolidColorBrush x:Key="NordAuroraOrange">#D08770</SolidColorBrush>
        <SolidColorBrush x:Key="NordAuroraYellow">#EBCB8B</SolidColorBrush>
        <SolidColorBrush x:Key="NordAuroraGreen">#A3BE8C</SolidColorBrush>
        <SolidColorBrush x:Key="NordAuroraPurple">#B48EAD</SolidColorBrush>
    </Application.Resources>
  
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#88C0D0" 
                                       BaseHigh="#ECEFF4"
                                       BaseMedium="#D8DEE9"
                                       BaseLow="#4C566A"
                                       ChromeHigh="#434C5E"
                                       ChromeMedium="#3B4252"
                                       ChromeLow="#2E3440"
                                       RegionColor="#2E3440"
                                       AltHigh="#2E3440"
                                       AltMedium="#3B4252"
                                       AltLow="#434C5E"
                                       ErrorText="#BF616A"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#4C566A" />
            <Setter Property="Foreground" Value="#ECEFF4" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3B4252" />
        </Style>
        <Style Selector="Window">
            <Setter Property="Background" Value="#2E3440" />
        </Style>
    </Application.Styles>
</Application>