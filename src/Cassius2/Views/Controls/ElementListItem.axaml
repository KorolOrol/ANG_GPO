<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Cassius2.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="50"
             x:Class="Cassius2.Views.Controls.ElementListItem">
    <Grid Height="50" ColumnDefinitions="50,*">
        <Svg Name="ElementIcon" Grid.Column="0" Stretch="Uniform"
               Path="{Binding $parent[local:ElementListItem].ItemIcon}" />
        <TextBlock Name="ElementName" Grid.Column="1" Text="{Binding $parent[local:ElementListItem].ItemText}"
                   VerticalAlignment="Center" Margin="5,0,0,0" />
    </Grid>
</UserControl>
