<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Cassius2.ViewModels.Windows"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        MaxWidth="600" MaxHeight="400" MinWidth="300" MinHeight="200"
        x:Class="Cassius2.Views.Windows.ExceptionWindow"
        x:DataType="vm:ExceptionWindowViewModel"
        Title="ExceptionWindow">
    <Grid RowDefinitions="Auto,*,Auto" Margin="10">
        <TextBlock Grid.Row="0" Text="An unexpected error occurred:" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
        <TextBox Grid.Row="1" Text="{Binding ExceptionMessage}" IsReadOnly="True" TextWrapping="Wrap" />
        <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right" Margin="0,10,0,0" Width="80"
                Command="{Binding CloseCommand}" />
    </Grid>
</Window>